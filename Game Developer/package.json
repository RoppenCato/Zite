{
  "name": "zite-game",
  "private": true,
  "version": "0.1.0",
  "description": "Robin's board world game: the rules, the Phaser client, the Node server.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p rules/tsconfig.json && tsc -p tsconfig.json",
    "server": "node server/src/index.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:8787",
    "icons": "node tools/make-icons.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "phaser": "^4.2.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
